# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=toolkit
POSTGRES_USER=toolkit_user
POSTGRES_PASSWORD=change_me_before_running
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- App ---
# Path to the monitoring config file used by the `toolkit` CLI on the host
# (relative paths are resolved from the current directory). Precedence:
# --config flag > TOOLKIT_CONFIG_PATH > ./config/config.yaml > bundled default.
# Docker Compose sets its own in-container path and mounts config/config.yaml.
TOOLKIT_CONFIG_PATH=config/config.yaml
# How often (seconds) the containerized monitor loop runs a full check cycle.
MONITOR_INTERVAL_SECONDS=60
# debug | info | warning | error | critical. Overrides logging.level in
# config.yaml. Invalid values fall back to info with a warning.
LOG_LEVEL=info

# --- Nginx ---
# Host port that maps to Nginx inside docker-compose.
NGINX_HOST_PORT=8080
