# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=toolkit
POSTGRES_USER=toolkit_user
POSTGRES_PASSWORD=change_me_before_running
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- App ---
# Path to the monitoring config file, inside the container or on the host.
TOOLKIT_CONFIG_PATH=config/config.yaml
# How often (seconds) the containerized monitor loop runs a full check cycle.
MONITOR_INTERVAL_SECONDS=60
# debug | info | warning | error
LOG_LEVEL=info

# --- Nginx ---
# Host port that maps to Nginx inside docker-compose.
NGINX_HOST_PORT=8080
